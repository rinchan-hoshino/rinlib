#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v docker >/dev/null 2>&1; then
  echo "minecraft mod local ci: docker is not installed, so containerized commit checks cannot run." >&2
  exit 1
fi

image_tag="$(basename "$repo_root")-local-ci:latest"
branch_name="$(git rev-parse --abbrev-ref HEAD)"
host_uid="$(id -u)"
host_gid="$(id -g)"
gradle_user_home="${GRADLE_USER_HOME:-$HOME/.gradle}"

if [[ "$host_uid" == "0" ]]; then
  echo "minecraft mod local ci: refusing to run as root." >&2
  exit 1
fi

if [[ ! -d "$gradle_user_home" || ! -w "$gradle_user_home" ]]; then
  echo "minecraft mod local ci: Gradle home is missing or not writable: $gradle_user_home" >&2
  exit 1
fi

lock_wait="${RIN_GRADLE_LOCK_WAIT_SECONDS:-30}"
if [[ ! "$lock_wait" =~ ^[0-9]+$ ]]; then
  echo "minecraft mod local ci: RIN_GRADLE_LOCK_WAIT_SECONDS must be a nonnegative integer." >&2
  exit 1
fi
lock_file="$gradle_user_home/.rin-build.lock"
exec 9>>"$lock_file"
if [[ "$(stat -c '%u' "$lock_file")" != "$host_uid" ]]; then
  echo "minecraft mod local ci: build lock is not owned by UID $host_uid: $lock_file" >&2
  exit 1
fi
if ! flock -w "$lock_wait" 9; then
  holder="$(tr '\n' ' ' <"$lock_file" 2>/dev/null || true)"
  echo "minecraft mod local ci: Gradle build lock busy after ${lock_wait}s; holder=${holder:-unknown}" >&2
  exit 75
fi
printf 'pid=%s started=%s cwd=%q command=RinLib-pre-commit\n' \
  "$$" "$(date --iso-8601=seconds)" "$repo_root" >"$lock_file"

foreign_path="$(find "$gradle_user_home" -xdev ! -uid "$host_uid" -print -quit)"
if [[ -n "$foreign_path" ]]; then
  echo "minecraft mod local ci: refusing mixed-ownership Gradle home: $foreign_path" >&2
  exit 1
fi

echo "minecraft mod local ci: building container image..."
docker build -f .ci/local-ci/Dockerfile --build-arg RINLIB_REF="$branch_name" -t "$image_tag" .

tree_id="$(git write-tree)"
archive_file="$(mktemp)"
trap 'rm -f "$archive_file"' EXIT
git archive --format=tar "$tree_id" >"$archive_file"

echo "minecraft mod local ci: running checks in container..."
docker run --rm \
  --user "$host_uid:$host_gid" \
  -e HOME="$HOME" \
  -e RUN_SERVER_SMOKE="${RUN_SERVER_SMOKE:-1}" \
  -e GRADLE_USER_HOME="$gradle_user_home" \
  -v "$gradle_user_home:$gradle_user_home" \
  -i "$image_tag" <"$archive_file"
